<%- include('../partials/app-start', { title }) %>
<div class="page-head"><div><h1>Chỉ số sức khỏe</h1><p class="sub">Theo dõi xu hướng theo thời gian và nhận cảnh báo khi vượt ngưỡng do bạn thiết lập.</p></div><% if(selected?.capabilities.canRecordMetric){ %><button class="btn btn-secondary" type="button" data-toggle-target="metricForm">＋ Ghi nhận chỉ số mới</button><% } %></div>
<% if (!profiles.length) { %><div class="empty-state">Bạn chưa có hồ sơ sức khỏe đang hoạt động.</div><% } else { %>
<div class="tabstrip"><% profiles.forEach(x => { %><a class="tabchip <%= Number(profileId)===Number(x.profile.id)?'is-active':'' %>" href="/metrics?profileId=<%= x.profile.id %>"><span class="avatar sz-sm"><%= x.person.full_name.slice(0,1) %></span><%= x.person.full_name %><span class="mini-badge"><%= ui.access(x.accessLevel) %></span></a><% }) %></div>
<% if(selected && !selected.capabilities.canRecordMetric){ %><div class="role-banner">👁️ <div><b>Bạn đang xem hồ sơ ở chế độ chỉ đọc.</b><br>Lịch sử và biểu đồ vẫn hiển thị đầy đủ, nhưng chức năng ghi chỉ số và thiết lập ngưỡng đã được ẩn.</div></div><% } %>
<% if(selected?.capabilities.canRecordMetric){ %><section class="card card-pad" id="metricForm" hidden style="margin-bottom:20px"><div class="card-head" style="padding:0 0 16px;border:none"><div><h2>Ghi nhận chỉ số mới</h2><p>Chọn loại chỉ số và nhập đầy đủ các thành phần cần thiết.</p></div></div><form class="form-stack" method="post" action="/metrics"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="profileId" value="<%= profileId %>"><label class="field"><span>Loại chỉ số</span><select name="metricTypeId" id="metricTypeSelect" required><% catalog.forEach(t => { %><option value="<%= t.id %>" <%= Number(t.id)===Number(metricTypeId)?'selected':'' %>><%= t.name %></option><% }) %></select></label><% catalog.forEach((t) => { %><div data-metric-components="<%= t.id %>" <%= Number(t.id)===Number(metricTypeId)?'':'hidden' %>><div class="field-row"><% t.components.forEach(c => { %><label class="field"><span><%= c.name %> (<%= c.unit %>)</span><input type="number" step="any" name="component_<%= c.id %>"></label><% }) %></div></div><% }) %><div class="field-row"><label class="field"><span>Thời gian đo</span><input type="datetime-local" name="measuredAt"></label><label class="field"><span>Ghi chú</span><input name="note" maxlength="500"></label></div><button class="btn btn-primary" type="submit">Lưu chỉ số</button></form></section><% } %>
<div class="metric-grid"><% catalog.forEach((t) => { const rec = overviewHistory.find(h => Number(h.metric_type_id)===Number(t.id)); %><a class="metric-card <%= Number(metricTypeId)===Number(t.id)?'is-selected':'' %>" href="/metrics?profileId=<%= profileId %>&metricTypeId=<%= t.id %>"><p class="m-label"><%= t.name %></p><div class="metric-value-line"><% if(rec?.values?.length){ rec.values.forEach((v,i)=>{ %><span class="metric-component-value"><b><%= Number(v.numeric_value) %></b><small><%= v.component?.unit || '' %></small></span><% }) } else { %><span class="m-value">—</span><% } %></div><p class="m-trend <%= rec?.is_alert ? 'trend-up':'trend-ok' %>"><%= rec?.is_alert ? 'Có giá trị vượt ngưỡng':'Không có cảnh báo mới' %></p></a><% }) %></div>
<% const alertRecord = history.find(h => h.is_alert); if (alertRecord) { %><div class="alert-banner">⚠ Có bản ghi gần đây vượt ngưỡng bạn đã thiết lập. Cảnh báo này không phải chẩn đoán y khoa.</div><% } %>
<section class="card card-pad metric-chart-card" style="margin-bottom:20px"><div class="card-head" style="padding:0 0 16px;border:none"><div><h2>Xu hướng <%= selectedType?.name || '' %></h2><p>Di chuột lên điểm đo để xem thời gian và giá trị chi tiết.</p></div></div><% if(chartData.rows.length > 1 && chartData.series.length){ %><div class="chart-toolbar"><div class="chart-legend" data-chart-legend></div><label class="chart-threshold-select">Đường ngưỡng của <select data-threshold-series><% chartData.series.forEach(s=>{ %><option value="<%= s.id %>"><%= s.name %></option><% }) %></select></label></div><div class="chart-wrap chart-wrap-v3"><svg class="metric-line-chart-v3" viewBox="0 0 760 320" role="img" aria-label="Biểu đồ xu hướng" data-multi-chart data-chart='<%= JSON.stringify(chartData) %>'></svg><div class="chart-tooltip" data-chart-tooltip hidden></div></div><% } else { %><div class="empty-state">Cần ít nhất 2 lần ghi nhận để hiển thị xu hướng.</div><% } %></section>
<div class="grid-2b"><section class="card card-pad"><div class="card-head" style="padding:0 0 16px;border:none"><div><h2>Lịch sử ghi nhận</h2><p><%= Math.min(history.length, 7) %> bản ghi gần nhất</p></div></div><% if (!history.length) { %><div class="empty-state">Chưa có dữ liệu chỉ số.</div><% } %><% history.slice(0,7).forEach(r => { %><div class="list-row"><div><p class="l-title"><%= r.metricType?.name || 'Chỉ số' %></p><p class="l-sub"><%= r.values.map(v => `${v.component?.name || ''}: ${Number(v.numeric_value)} ${v.component?.unit || ''}`).join(' · ') %></p></div><div class="history-meta"><span class="<%= r.is_alert?'pill tone-red':'pill tone-mint' %>"><%= r.is_alert?'Vượt ngưỡng':'Trong ngưỡng' %></span><small><%= new Intl.DateTimeFormat('vi-VN',{timeZone:'Asia/Ho_Chi_Minh',dateStyle:'short',timeStyle:'short'}).format(new Date(r.measured_at)) %></small></div></div><% }) %></section>
<section class="card card-pad"><div class="card-head" style="padding:0 0 16px;border:none"><div><h2>Ngưỡng cảnh báo</h2><p>Đường tối thiểu/tối đa sẽ xuất hiện trên biểu đồ.</p></div></div><% if(!selected?.capabilities.canManageThreshold){ %><div class="empty-state">Bạn có thể xem ngưỡng hiện tại nhưng không thể thay đổi.</div><% } %><% (selectedType?.components || []).forEach(c=>{ const th=thresholds.find(t=>Number(t.component_id)===Number(c.id)); %><form class="threshold-editor" method="post" action="/metrics/thresholds"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="profileId" value="<%= profileId %>"><input type="hidden" name="metricTypeId" value="<%= metricTypeId %>"><input type="hidden" name="componentId" value="<%= c.id %>"><div class="threshold-title"><b><%= c.name %></b><span><%= c.unit %></span></div><div class="field-row"><label class="field"><span>Tối thiểu</span><input type="number" step="any" name="minValue" value="<%= th?.min_value ?? '' %>" <%= selected?.capabilities.canManageThreshold?'':'disabled' %>></label><label class="field"><span>Tối đa</span><input type="number" step="any" name="maxValue" value="<%= th?.max_value ?? '' %>" <%= selected?.capabilities.canManageThreshold?'':'disabled' %>></label></div><label class="check-row"><input type="checkbox" name="enabled" <%= th?.enabled?'checked':'' %> <%= selected?.capabilities.canManageThreshold?'':'disabled' %>><span>Bật cảnh báo</span></label><% if(selected?.capabilities.canManageThreshold){ %><button class="btn btn-secondary btn-sm">Lưu ngưỡng</button><% } %></form><% }) %></section></div>
<% } %>
<%- include('../partials/app-end') %>
