<%- include('../partials/app-start', { title }) %>
<div class="page-head"><div><p class="eyebrow">THEO DÕI SAU KHÁM</p><h1>Kết quả khám</h1><p class="sub">Chỉ nhập kết quả khi đến ngày khám đã xác nhận. Lịch đã hoàn tất được lưu ở phần lịch sử.</p></div><a class="btn btn-secondary" href="/facility/appointments">Yêu cầu lịch hẹn</a></div>
<div class="ui-core-kpi-strip"><div><span>Đến hạn hôm nay</span><strong><%= visitQueue.today.length %></strong></div><div><span>Quá hạn nhập</span><strong><%= visitQueue.overdue.length %></strong></div><div><span>Sắp đến lịch</span><strong><%= visitQueue.upcoming.length %></strong></div><div><span>Đã hoàn tất</span><strong><%= completed.length %></strong></div></div>
<% function queueSection(title, rows, note, tone){ %>
<section class="ui-core-results-section card card-pad"><div class="ui-core-section-head"><div><h2><%= title %></h2><p><%= note %></p></div><span class="pill <%= tone %>"><%= rows.length %> lịch</span></div>
<% if(!rows.length){ %><div class="empty-state">Không có lịch trong nhóm này.</div><% } %>
<div class="ui-core-simple-list"><% rows.forEach(a=>{ %><div class="ui-core-result-row"><div><b><%= a.profile?.person?.full_name || 'Hồ sơ' %></b><small><%= new Intl.DateTimeFormat('vi-VN',{timeZone:'Asia/Ho_Chi_Minh',dateStyle:'medium',timeStyle:'short',timeZone:'Asia/Ho_Chi_Minh'}).format(new Date(a.confirmed_for)) %> · <%= a.reason || 'Không ghi lý do khám' %></small></div><% if(tone === 'tone-neutral'){ %><span class="pill tone-blue">Chưa đến ngày</span><% } else { %><a class="btn btn-primary btn-sm" href="/facility/appointments/<%= a.id %>/result">Nhập kết quả</a><% } %></div><% }) %></div>
</section><% } %>
<% queueSection('Cần nhập kết quả hôm nay',visitQueue.today,'Lịch đã xác nhận diễn ra trong ngày hôm nay.','tone-mint'); %>
<% queueSection('Quá hạn nhập kết quả',visitQueue.overdue,'Lịch đã qua ngày khám nhưng chưa có kết quả chính thức.','tone-red'); %>
<% queueSection('Lịch khám sắp tới',visitQueue.upcoming,'Chưa được nhập kết quả trước ngày khám.','tone-neutral'); %>
<section class="ui-core-results-section card card-pad"><div class="ui-core-section-head"><div><h2>Lịch sử đã hoàn tất</h2><p>Kết quả và tình trạng hóa đơn.</p></div><span class="pill tone-mint"><%= completed.length %> lịch</span></div>
<% if(!completed.length){ %><div class="empty-state">Chưa có kết quả khám đã hoàn tất.</div><% } %>
<% completed.forEach(a=>{ const invoice=a.visitResult?.invoice; %><div class="ui-core-completed-row"><div><b><%= a.profile?.person?.full_name || 'Hồ sơ' %></b><small>Hoàn tất: <%= a.completed_at ? new Intl.DateTimeFormat('vi-VN',{timeZone:'Asia/Ho_Chi_Minh',dateStyle:'medium',timeStyle:'short'}).format(new Date(a.completed_at)) : '—' %></small></div><span class="pill tone-mint">Hoàn thành</span><% if(invoice){ %><span><%= Number(invoice.total_amount).toLocaleString('vi-VN') %> đ · <%= invoice.payment_status==='paid'?'Đã thanh toán':'Chưa thanh toán' %></span><form class="inline-actions" method="post" action="/facility/invoices/<%= invoice.id %>/payment"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><select name="paymentStatus" aria-label="Trạng thái hóa đơn"><option value="unpaid" <%= invoice.payment_status==='unpaid'?'selected':'' %>>Chưa thanh toán</option><option value="paid" <%= invoice.payment_status==='paid'?'selected':'' %>>Đã thanh toán</option></select><button class="btn btn-secondary btn-sm">Cập nhật</button></form><% } else { %><span class="pill tone-neutral">Không có hóa đơn</span><% } %></div><% }) %>
</section>
<%- include('../partials/app-end') %>
