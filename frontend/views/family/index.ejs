<%- include('../partials/app-start', { title }) %>
<div class="page-head"><div><h1>Gia đình</h1><p class="sub">Quản lý thành viên và người phụ thuộc trong cùng một không gian. Quyền xem hồ sơ sức khỏe vẫn được quản lý riêng.</p></div></div>
<% if (!family) { %><div class="family-split"><section class="card card-pad"><div class="card-head" style="padding:0 0 14px;border:none"><h2>Tạo nhóm gia đình</h2></div><form class="form-stack" method="post" action="/family/create"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="field"><span>Tên nhóm</span><input name="name" required placeholder="VD: Gia đình An"></label><button class="btn btn-primary">Tạo nhóm</button></form></section><section class="card card-pad"><div class="card-head" style="padding:0 0 14px;border:none"><h2>Tham gia nhóm</h2></div><form class="form-stack" method="post" action="/family/join"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="field"><span>Mã mời</span><input name="inviteCode" required placeholder="VD: 7F3K29QX"></label><button class="btn btn-secondary">Gửi yêu cầu tham gia</button></form></section></div><% } else { %>
<div class="role-banner">👥 <div><b><%= family.name %></b><br><%= isOwner ? 'Bạn đang quản lý nhóm gia đình này.' : 'Bạn là thành viên của nhóm gia đình.' %></div></div>
<% if (isOwner) { %><div class="invite-box"><div class="invite-copy"><b>Mã mời gia đình</b><span><%= invites[0] ? 'Mã hiện tại có hiệu lực trong 24 giờ kể từ lúc tạo.' : 'Chưa có mã mời còn hiệu lực.' %></span></div><% if(invites[0]){ %><span class="invite-code"><%= invites[0].code %></span><button type="button" class="btn btn-secondary btn-sm" data-copy-text="<%= invites[0].code %>">Sao chép</button><span class="invite-expiry">Hết hạn: <%= new Intl.DateTimeFormat('vi-VN',{timeZone:'Asia/Ho_Chi_Minh',dateStyle:'short',timeStyle:'short'}).format(new Date(invites[0].expires_at)) %></span><% } %><form method="post" action="/family/invites"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-primary btn-sm"><%= invites[0]?'Tạo mã mới':'Tạo mã mời' %></button></form></div><% } %>
<section class="card card-pad family-directory"><div class="card-head" style="padding:0 0 16px;border:none"><div><h2>Thành viên gia đình</h2><p><%= people.length %> người trong nhóm</p></div><% if(isOwner){ %><button type="button" class="btn btn-secondary btn-sm" data-toggle-target="dependent-create">+ Người phụ thuộc</button><% } %></div><% if(isOwner){ %><div class="dependent-create-panel" id="dependent-create" <%= openDependentForm ? '' : 'hidden' %>><div class="card-head" style="padding:0 0 14px;border:none"><h3>Thêm người phụ thuộc</h3></div><form class="form-grid" method="post" action="/family/dependents"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="field"><span>Họ tên</span><input name="fullName" required maxlength="120" autocomplete="off"></label><label class="field"><span>Ngày sinh</span><input type="date" name="dateOfBirth"></label><label class="field"><span>Quan hệ</span><input name="relationship" placeholder="Con, Mẹ..." maxlength="50"></label><label class="field"><span>Người quản lý hồ sơ</span><select name="managerUserId" required><% members.forEach(m=>{ %><option value="<%= m.user_id %>"><%= m.full_name %></option><% }) %></select></label><label class="check-row full"><input type="checkbox" name="authorizedRepresentative" required><span>Tôi xác nhận mình có quyền phù hợp để cung cấp và quản lý thông tin của người này.</span></label><label class="check-row full"><input type="checkbox" name="healthConsent" required><span>Tôi đồng ý việc xử lý dữ liệu sức khỏe của người phụ thuộc cho các chức năng Carely.</span></label><div class="full"><button class="btn btn-primary">Tạo người phụ thuộc</button></div></form></div><% } %><div class="family-list-head"><span>Người</span><span>Loại</span><span>Vai trò / quản lý</span><span>Trạng thái</span><span></span></div><% people.forEach(item=>{ const p=item.row; %><div class="family-list-row"><div class="who-cell"><span class="avatar sz-md"><%= p.full_name.slice(0,1) %></span><div><b><%= p.full_name %></b><small><%= item.kind==='member' ? (p.user?.email || '') : (p.relationship_to_manager || 'Quan hệ chưa cập nhật') %></small></div></div><div><span class="mini-badge <%= item.kind==='dependent'?'dependent':'' %>"><%= item.kind==='member'?'Có tài khoản':'Người phụ thuộc' %></span></div><div><%= item.kind==='member' ? (Number(family.owner_user_id)===Number(p.user_id)?'Chủ nhà':'Thành viên') : ('Quản lý: '+(p.manager?.display_name || '—')) %></div><div><span class="pill <%= p.status==='active'?'tone-mint':'tone-amber' %>"><%= ui.status(p.status) %></span></div><div class="family-action-cell"><% if(isOwner && (item.kind==='dependent' || Number(p.user_id)!==Number(currentUser.id))){ %><details class="action-menu"><summary aria-label="Thao tác">⋯</summary><div class="action-menu-popover"><% if(item.kind==='member'){ %><form method="post" action="/family/transfer-owner" data-confirm="Chuyển quyền Chủ nhà cho thành viên này?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="newOwnerUserId" value="<%= p.user_id %>"><button>Chuyển quyền Chủ nhà</button></form><form method="post" action="/family/members/<%= p.user_id %>/remove" data-confirm="Xóa thành viên này khỏi nhóm?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="danger-link">Xóa khỏi nhóm</button></form><% } else { %><button type="button" data-toggle-target="dependent-edit-<%= p.id %>">Chỉnh sửa / chuyển người quản lý</button><form method="post" action="/family/dependents/<%= p.id %>" data-confirm="Ngừng quản lý người phụ thuộc này?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="status" value="inactive"><input type="hidden" name="fullName" value="<%= p.full_name %>"><button class="danger-link">Ngừng quản lý</button></form><% } %></div></details><% } %></div></div><% if(item.kind==='dependent' && isOwner){ %><div id="dependent-edit-<%= p.id %>" class="inline-edit-panel" hidden><form class="form-grid" method="post" action="/family/dependents/<%= p.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="field"><span>Họ tên</span><input name="fullName" value="<%= p.full_name %>" required></label><label class="field"><span>Ngày sinh</span><input type="date" name="dateOfBirth" value="<%= p.date_of_birth ? String(p.date_of_birth).slice(0,10) : '' %>"></label><label class="field"><span>Quan hệ</span><input name="relationship" value="<%= p.relationship_to_manager || '' %>"></label><label class="field"><span>Người quản lý hồ sơ</span><select name="managerUserId"><% members.forEach(m=>{ %><option value="<%= m.user_id %>" <%= Number(m.user_id)===Number(p.manager_user_id)?'selected':'' %>><%= m.full_name %></option><% }) %></select></label><label class="check-row full"><input type="checkbox" name="healthConsent"><span>Tôi xác nhận sự đồng ý xử lý dữ liệu sức khỏe khi thay đổi người quản lý hồ sơ.</span></label><div class="full"><button class="btn btn-primary btn-sm">Lưu thay đổi</button></div></form></div><% } %><% }) %></section>

<% if(isOwner){ %><div class="section-title"><div><h2>Yêu cầu tham gia</h2><p>Duyệt người đã sử dụng mã mời của gia đình</p></div></div><section class="card card-pad"><% if(!requests.length){ %><div class="empty-state">Không có yêu cầu đang chờ.</div><% } %><% requests.forEach(r=>{ %><div class="list-row"><div><p class="l-title"><%= r.dataValues.requestUser?.display_name || r.user_id %></p><p class="l-sub"><%= new Intl.DateTimeFormat('vi-VN',{timeZone:'Asia/Ho_Chi_Minh',dateStyle:'short',timeStyle:'short'}).format(new Date(r.requested_at)) %></p></div><div class="inline-actions"><form method="post" action="/family/join-requests/<%= r.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="action" value="approve"><button class="btn btn-success btn-sm">Duyệt</button></form><form method="post" action="/family/join-requests/<%= r.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="action" value="reject"><button class="btn btn-danger btn-sm">Từ chối</button></form></div></div><% }) %></section><% } %>
<% if(!isOwner){ %><form method="post" action="/family/leave" style="margin-top:20px" data-confirm="Bạn muốn rời nhóm gia đình?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-danger">Rời nhóm gia đình</button></form><% } %><% } %>
<%- include('../partials/app-end') %>
