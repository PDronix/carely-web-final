<%- include('../partials/app-start', { title }) %><div class="page-head"><div><h1>Cơ sở y tế</h1><p class="sub">Xem thông tin đăng ký, giấy phép và cập nhật trạng thái tài khoản.</p></div></div><% if(!facilities.length){ %><div class="empty-state">Chưa có cơ sở y tế đăng ký.</div><% } %><div class="admin-facility-list"><% facilities.forEach(f=>{ %><section class="card admin-facility-card"><div class="admin-facility-main"><div class="facility-heading"><span class="facility-icon">✚</span><div><h2><%= f.facility_name %></h2><p><%= f.user?.email %> · <%= f.phone || 'Chưa có số điện thoại' %></p></div></div><div class="facility-detail-grid"><div><small>Mã giấy phép</small><b><%= f.license_number %></b></div><div><small>Địa chỉ</small><b><%= f.address || 'Chưa cập nhật' %></b></div></div><div class="document-row"><% if(!(f.documents||[]).length){ %><span class="mini-badge expired">Chưa có tài liệu</span><% } %><% (f.documents||[]).forEach(d=>{ %><a class="btn btn-secondary btn-sm" href="/admin/facilities/<%= f.id %>/documents/<%= d.id %>">Xem giấy phép</a><% }) %></div></div><aside class="admin-facility-actions"><div class="status-pair"><span class="pill <%= f.verification_status==='approved'?'tone-mint':f.verification_status==='pending'?'tone-peach':'tone-red' %>"><%= ui.status(f.verification_status) %></span><span class="pill <%= f.user?.status==='active'?'tone-mint':'tone-red' %>"><%= ui.status(f.user?.status) %></span></div><% if(f.verification_status==='pending'){ %><div class="action-column"><form method="post" action="/admin/facilities/<%= f.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="action" value="approve"><button class="btn btn-success btn-sm">Duyệt hồ sơ</button></form><button class="btn btn-danger btn-sm" type="button" data-toggle-target="reject-<%= f.id %>">Từ chối</button><form id="reject-<%= f.id %>" hidden class="reject-form" method="post" action="/admin/facilities/<%= f.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="action" value="reject"><label class="field"><span>Lý do cần bổ sung</span><textarea name="reason" required maxlength="500"></textarea></label><button class="btn btn-danger btn-sm">Xác nhận từ chối</button></form></div><% } %><form method="post" action="/admin/facilities/<%= f.id %>" data-confirm="Cập nhật trạng thái khóa tài khoản cơ sở?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="action" value="<%= f.user?.status==='locked'?'unlock':'lock' %>"><button class="btn <%= f.user?.status==='locked'?'btn-secondary':'btn-danger-ghost' %> btn-sm"><%= f.user?.status==='locked'?'Mở khóa tài khoản':'Khóa tài khoản' %></button></form></aside></section><% }) %></div><%- include('../partials/app-end') %>
