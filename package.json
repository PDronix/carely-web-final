{
  "name": "carely-web-final",
  "version": "4.7.0",
  "private": true,
  "description": "Carely - Website quản lý thông tin sức khỏe, nhắc lịch chăm sóc sức khỏe và hỗ trợ kết nối với cơ sở y tế",
  "main": "backend/server.js",
  "scripts": {
    "dev": "nodemon backend/server.js",
    "start": "node backend/server.js",
    "seed": "node scripts/seed.js",
    "seed:demo": "node scripts/seed-demo.js",
    "verify:demo": "node scripts/verify-demo.js",
    "test": "node --test",
    "test:integration": "node scripts/run-test-db.js test",
    "seed:test": "node scripts/run-test-db.js seed",
    "demo:reset:plan": "node scripts/reset-demo.js --dry-run",
    "demo:reset": "node scripts/reset-demo.js",
    "check:source": "node scripts/check-source.js",
    "test:preflight": "node scripts/check-test-db.js",
    "demo:setup": "node scripts/setup-demo.js"
