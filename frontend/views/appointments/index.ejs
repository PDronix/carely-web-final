<%- include('../partials/app-start', { title }) %>
<div class="page-head"><div><h1>Lịch hẹn với cơ sở y tế</h1><p class="sub">Theo dõi lịch hẹn và quyền chia sẻ hồ sơ theo từng cuộc hẹn.</p></div><a class="btn btn-secondary" href="/facilities">+ Đặt lịch mới</a></div>
<div class="role-banner">🔐 <div><b>Quyền truy cập của cơ sở y tế chỉ bắt đầu khi lịch đã xác nhận.</b><br>Bạn có thể theo dõi và thu hồi quyền của những lịch mình được phép quản lý.</div></div>
<% if (!rows.length) { %><div class="empty-state">Chưa có lịch hẹn với cơ sở y tế.</div><% } %>
<% rows.forEach(row => { const a=row.appointment; const when=a.confirmed_for||a.proposed_for||a.requested_for; %><section class="appt-card"><div class="appt-top"><div><h3><%= a.profile?.person?.full_name || 'Hồ sơ' %> — <%= a.facility?.facility_name || 'Cơ sở y tế' %></h3><p><%= new Intl.DateTimeFormat('vi-VN',{timeZone:'Asia/Ho_Chi_Minh',dateStyle:'medium',timeStyle:'short'}).format(new Date(when)) %></p></div><span class="pill <%= a.status==='confirmed'?'tone-mint':a.status==='proposed_time'?'tone-blue':a.status==='pending'?'tone-peach':a.status==='completed'?'tone-mint':'tone-red' %>"><%= ui.appointmentStatus(a.status) %></span></div>
<% if (a.status === 'confirmed') { %><div class="access-strip <%= a.access_revoked_at?'off':'' %>"><span><%= a.access_revoked_at ? 'Quyền truy cập của cơ sở đã được thu hồi' : '✓ Cơ sở đang có quyền truy cập trong phạm vi lịch hẹn này' %></span><% if(!a.access_revoked_at && row.canManage){ %><form method="post" action="/appointments/<%= a.id %>" data-confirm="Thu hồi quyền truy cập của cơ sở y tế cho lịch hẹn này?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="action" value="revoke-access"><button class="btn btn-secondary btn-sm">Thu hồi quyền</button></form><% } %></div><% } else { %><div class="access-strip off"><span><%= a.status === 'completed' ? 'Lịch đã hoàn thành; quyền truy cập theo lịch hẹn đã kết thúc' : ['cancelled','rejected'].includes(a.status) ? 'Lịch đã kết thúc; cơ sở không có quyền truy cập theo lịch hẹn này' : 'Cơ sở chỉ được truy cập hồ sơ sau khi lịch được xác nhận' %></span></div><% } %>
<% if (a.facility_response_note && ['proposed_time','confirmed','cancelled','rejected'].includes(a.status)) { %><div class="ui-appointments-facility-feedback" role="note"><strong>Phản hồi của cơ sở y tế:</strong> <%= a.facility_response_note %></div><% } %>
<% if(row.canManage && a.status === 'proposed_time') { %><div class="proposal-box"><b>Cơ sở đề xuất:</b> <%= new Intl.DateTimeFormat('vi-VN',{timeZone:'Asia/Ho_Chi_Minh',dateStyle:'medium',timeStyle:'short'}).format(new Date(a.proposed_for)) %></div><div class="inline-actions"><form method="post" action="/appointments/<%= a.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="action" value="accept-proposal"><button class="btn btn-success btn-sm">Đồng ý thời gian</button></form><form method="post" action="/appointments/<%= a.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="action" value="reject-proposal"><button class="btn btn-danger btn-sm">Từ chối</button></form></div><% } %>
<% if(row.canManage && (a.status === 'pending' || (a.status === 'confirmed' && new Date(a.confirmed_for) > new Date()))) { %><div class="inline-actions"><form method="post" action="/appointments/<%= a.id %>" data-confirm="Bạn muốn hủy lịch hẹn này?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="action" value="cancel"><button class="btn btn-danger btn-sm">Hủy lịch</button></form></div><% } %>
<% if(!row.canManage && ['pending','proposed_time','confirmed'].includes(a.status)){ %><div class="permission-lock">Bạn có quyền xem hồ sơ này nhưng không có quyền thay đổi lịch hẹn hoặc chia sẻ quyền cho cơ sở y tế.</div><% } %>
<% if (a.status === 'completed' && a.visitResult) { %><div class="appt-detail is-open"><div class="official-box">Kết quả dưới đây do cơ sở y tế nhập. Thành viên có thể xem nhưng không chỉnh sửa trực tiếp.</div><div class="row"><span>Bác sĩ khám</span><span><%= a.visitResult.doctor_name || '—' %></span></div><div class="row"><span>Chẩn đoán</span><span><%= a.visitResult.diagnosis || '—' %></span></div><% if(a.visitResult.prescriptions?.length){ %><p style="font-size:13px;font-weight:700;margin:14px 0 6px">Đơn thuốc</p><% a.visitResult.prescriptions.forEach(m=>{ %><div class="rx-item"><span><%= m.name %></span><span><%= m.dosage || '' %></span></div><% }) %><% } %><% if(a.visitResult.invoice){ %><div class="invoice-total"><span>Hóa đơn</span><span><%= Number(a.visitResult.invoice.total_amount).toLocaleString('vi-VN') %>đ · <%= a.visitResult.invoice.payment_status==='paid'?'Đã thanh toán':'Chưa thanh toán' %></span></div><% } %></div><% } %></section><% }) %>
<%- include('../partials/app-end') %>
