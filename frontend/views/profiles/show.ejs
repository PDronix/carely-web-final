<%- include('../partials/app-start', { title }) %>
<div class="page-head"><div><p class="eyebrow">HỒ SƠ SỨC KHỎE</p><h1><%= profile.person.full_name %></h1><p class="sub">Dữ liệu sức khỏe theo quyền hiện tại của bạn.</p></div><a class="btn btn-secondary" href="/profiles">← Danh sách hồ sơ</a></div>
<div class="tabstrip"><span class="tabchip is-active"><%= accessLevel === 'full' ? 'Toàn quyền' : 'Chỉ xem' %></span><% if (profile.person.person_type === 'dependent') { %><span class="tabchip">Người phụ thuộc</span><% } %></div>
<div class="record-grid">
  <div>
    <section class="card card-pad" style="margin-bottom:18px"><div class="card-head" style="padding:0 0 14px;border:none"><div><h2>Thông tin hồ sơ</h2><p>Dữ liệu do Thành viên quản lý</p></div></div>
      <form class="form-stack" method="post" action="/profiles/<%= profile.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="field"><span>Nhóm máu</span><select name="bloodType" <%= accessLevel !== 'full' ? 'disabled' : '' %>><% ['unknown','A+','A-','B+','B-','AB+','AB-','O+','O-'].forEach(v => { %><option value="<%= v %>" <%= profile.blood_type===v?'selected':'' %>><%= v %></option><% }) %></select></label><label class="field"><span>Ghi chú chung</span><textarea name="generalNote" <%= accessLevel !== 'full' ? 'disabled' : '' %>><%= profile.general_note || '' %></textarea></label><% if (accessLevel === 'full') { %><button class="btn btn-primary" type="submit">Lưu thay đổi</button><% } %></form>
    </section>
    <section class="card card-pad" style="margin-bottom:18px"><div class="card-head" style="padding:0 0 14px;border:none"><h2>Bệnh án</h2></div><% if (!conditions.length) { %><div class="empty-state">Chưa có bệnh lý được ghi nhận.</div><% } %><% conditions.forEach(c => { %><div class="list-row"><div><p class="l-title"><%= c.condition_name %> <% if(c.source_type==='facility'){ %><span class="mini-badge expired">Chỉ đọc · CSYT</span><% } %></p><p class="l-sub"><%= c.note || 'Không có ghi chú' %></p></div></div><% }) %><% if (accessLevel === 'full') { %><form class="form-stack compact-form" method="post" action="/profiles/<%= profile.id %>/conditions"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="field"><span>Thêm bệnh lý</span><input name="conditionName" required></label><label class="field"><span>Ghi chú</span><input name="note"></label><button class="btn btn-secondary btn-sm">+ Thêm</button></form><% } %></section>
    <section class="card card-pad"><div class="card-head" style="padding:0 0 14px;border:none"><h2>Kiêng khem & dị ứng</h2></div><% restrictions.forEach(r => { %><div class="list-row"><div><p class="l-title"><%= r.name %></p><p class="l-sub"><%= r.restriction_type %> · <%= r.note || '' %></p></div></div><% }) %><% if (accessLevel === 'full') { %><form class="form-stack compact-form" method="post" action="/profiles/<%= profile.id %>/restrictions"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="field-row"><label class="field"><span>Loại</span><select name="restrictionType"><option value="allergy">Dị ứng</option><option value="dietary">Kiêng khem</option><option value="other">Khác</option></select></label><label class="field"><span>Tên</span><input name="name" required></label></div><label class="field"><span>Ghi chú</span><input name="note"></label><button class="btn btn-secondary btn-sm">+ Thêm</button></form><% } %></section>
  </div>
  <aside>
    <section class="card card-pad"><div class="card-head" style="padding:0 0 14px;border:none"><div><h2>Ai được xem hồ sơ này</h2><p>Bạn quyết định ai được xem hoặc chỉnh sửa hồ sơ này.</p></div></div><% if (!canManagePermissions) { %><div class="permission-lock">🔒 Bạn không phải chủ hồ sơ/người quản lý nên không thể thay đổi quyền.</div><% } %><% if (canManagePermissions) { permissions.forEach(p => { %><div class="perm-row"><span><%= p.grantee?.display_name || p.grantee_user_id %></span><span class="mini-badge access"><%= ui.access(p.access_level) %></span></div><% }) } %><% if (canManagePermissions && familyMembers.length) { %><form class="form-stack" method="post" action="/profiles/<%= profile.id %>/permissions"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="field"><span>Thành viên</span><select name="granteeUserId"><% familyMembers.forEach(m => { if(Number(m.user_id)!==Number(currentUser.id)){ %><option value="<%= m.user_id %>"><%= m.user?.display_name || m.full_name %></option><% } }) %></select></label><label class="field"><span>Mức quyền</span><select name="accessLevel"><option value="view">Chỉ xem</option><option value="full">Toàn quyền</option><option value="none">Thu hồi</option></select></label><button class="btn btn-primary btn-sm">Cập nhật quyền</button></form><% } %></section>
    <section class="card card-pad" style="margin-top:18px"><div class="card-head" style="padding:0 0 14px;border:none"><h2>Ghi chú chăm sóc</h2></div><% notes.slice(0,5).forEach(n => { %><div class="note-item"><div><p class="note-body"><%= n.content %></p><div class="note-foot"><%= new Intl.DateTimeFormat('vi-VN',{timeZone:'Asia/Ho_Chi_Minh',dateStyle:'short',timeStyle:'short'}).format(new Date(n.created_at)) %></div></div></div><% }) %><% if(capabilities.canWriteCareNote){ %><form class="composer" method="post" action="/profiles/<%= profile.id %>/notes"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><textarea name="content" placeholder="Viết ghi chú..."></textarea><button class="btn btn-primary btn-sm">Gửi</button></form><% } else { %><div class="permission-lock">Bạn chỉ có quyền xem nên không thể thêm ghi chú cho hồ sơ này.</div><% } %></section>
  </aside>
</div>
<%- include('../partials/app-end') %>
