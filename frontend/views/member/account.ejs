<%- include('../partials/app-start', { title }) %>
<div class="page-head"><div><h1>Thông tin tài khoản</h1><p class="sub">Cập nhật thông tin hiển thị và bảo vệ tài khoản của bạn.</p></div><% if(currentUser.account_type==='member'){ %><a class="btn btn-secondary" href="/account/privacy">Quyền riêng tư & dữ liệu</a><% } %></div>
<div class="grid-2b">
  <section class="card card-pad"><div class="card-head" style="padding:0 0 16px;border:none"><h2>Thông tin cơ bản</h2></div><form class="form-stack" method="post" action="/account"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="field"><span>Tên hiển thị</span><input name="displayName" value="<%= currentUser.display_name %>" required></label><label class="field"><span>Số điện thoại</span><input name="phone" value="<%= currentUser.phone || '' %>"></label><% if(facility){ %><label class="field"><span>Tên cơ sở</span><input name="facilityName" value="<%= facility.facility_name %>"></label><label class="field"><span>Địa chỉ</span><input name="address" value="<%= facility.address || '' %>"></label><label class="field"><span>Chuyên khoa / lĩnh vực khám</span><input name="specialty" maxlength="180" value="<%= facility.specialty || '' %>"></label><label class="field"><span>Mô tả</span><textarea name="description"><%= facility.description || '' %></textarea></label><div class="muted-box">Mã giấy phép: <b><%= facility.license_number %></b> · Trạng thái xác minh: <b><%= ui.status(facility.verification_status) %></b><br><small>Nếu thay đổi tên, địa chỉ hoặc chuyên khoa sau khi đã được duyệt, hồ sơ sẽ chuyển về trạng thái chờ duyệt để bảo đảm thông tin xác minh luôn khớp.</small></div><% } %><button class="btn btn-primary">Lưu thay đổi</button></form></section>
  <section class="card card-pad"><div class="card-head" style="padding:0 0 16px;border:none"><h2>Đổi mật khẩu</h2></div><form class="form-stack" method="post" action="/account/password"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="field"><span>Mật khẩu hiện tại</span><input type="password" name="currentPassword" required></label><label class="field"><span>Mật khẩu mới</span><input type="password" name="newPassword" required></label><label class="field"><span>Xác nhận mật khẩu mới</span><input type="password" name="confirmPassword" required></label><button class="btn btn-secondary">Đổi mật khẩu</button><p class="legal-note">Sau khi đổi mật khẩu, các phiên đăng nhập cũ trên thiết bị khác sẽ được đăng xuất để bảo vệ tài khoản.</p></form></section>
</div>
<%- include('../partials/app-end') %>
