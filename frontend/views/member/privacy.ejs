<%- include('../partials/app-start', { title }) %>
<div class="page-head"><div><h1>Quyền riêng tư & dữ liệu</h1><p class="sub">Xem các lựa chọn bạn đã đồng ý và quản lý quyền xử lý dữ liệu sức khỏe.</p></div></div>
<section class="card card-pad"><div class="card-head" style="padding:0 0 16px;border:none"><div><h2>Lịch sử đồng ý</h2><p>Carely lưu thời điểm và phiên bản nội dung bạn đã đồng ý để bạn có thể kiểm tra lại khi cần.</p></div></div><div class="table-wrap"><table><thead><tr><th>Loại</th><th>Phiên bản</th><th>Đối tượng</th><th>Trạng thái</th><th>Thời điểm</th></tr></thead><tbody><% consents.forEach(c=>{ %><tr><td><%= c.consent_type==='health_data'?'Dữ liệu sức khỏe cá nhân':c.consent_type==='dependent_health_data'?'Dữ liệu sức khỏe người phụ thuộc':c.consent_type==='privacy'?'Quyền riêng tư':'Điều khoản sử dụng' %></td><td><%= c.document_version %></td><td><%= c.subject_person_id ? (personNames[String(c.subject_person_id)] || 'Hồ sơ sức khỏe') : 'Tài khoản' %></td><td><span class="pill <%= c.status==='granted'?'tone-mint':'tone-red' %>"><%= c.status==='granted'?'Đã đồng ý':'Đã rút lại' %></span></td><td><%= new Intl.DateTimeFormat('vi-VN',{timeZone:'Asia/Ho_Chi_Minh',dateStyle:'short',timeStyle:'short'}).format(new Date(c.granted_at)) %></td></tr><% }) %></tbody></table></div></section>
<% const activeHealth = consents.filter(c => c.consent_type==='health_data' && c.status==='granted'); if(activeHealth.length){ %><section class="card card-pad danger-zone" style="margin-top:18px"><h2>Rút lại sự đồng ý xử lý dữ liệu sức khỏe</h2><p style="font-size:13px;color:var(--muted)">Sau khi rút lại, các chức năng cần xử lý dữ liệu sức khỏe của hồ sơ đó sẽ không tiếp tục hoạt động. Dữ liệu lịch sử không tự động bị xóa.</p><% activeHealth.forEach(c=>{ %><div class="list-row"><div><p class="l-title"><%= c.consent_type==='health_data'?'Dữ liệu sức khỏe cá nhân':c.consent_type==='dependent_health_data'?'Dữ liệu sức khỏe người phụ thuộc':c.consent_type==='privacy'?'Quyền riêng tư':'Điều khoản sử dụng' %> · <%= personNames[String(c.subject_person_id)] || 'Hồ sơ sức khỏe' %></p><p class="l-sub">Phiên bản <%= c.document_version %> · đồng ý lúc <%= new Intl.DateTimeFormat('vi-VN',{timeZone:'Asia/Ho_Chi_Minh',dateStyle:'short',timeStyle:'short'}).format(new Date(c.granted_at)) %></p></div><form method="post" action="/account/privacy/revoke-health" data-confirm="Bạn chắc chắn muốn rút lại sự đồng ý xử lý dữ liệu sức khỏe này?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="subjectPersonId" value="<%= c.subject_person_id %>"><button class="btn btn-danger btn-sm">Rút lại sự đồng ý</button></form></div><% }) %></section><% } %>
<% if(managedDependentActive?.length){ %><section class="card card-pad danger-zone" style="margin-top:18px"><h2>Người phụ thuộc bạn đang quản lý</h2><p class="friendly-copy">Bạn có thể rút lại sự đồng ý đang hoạt động cho các hồ sơ dưới đây. Dữ liệu lịch sử không tự động bị xóa.</p><% managedDependentActive.forEach(x=>{ %><div class="list-row"><div><p class="l-title"><%= x.person.full_name %></p><p class="l-sub">Đồng ý phiên bản <%= x.consent.document_version %></p></div><form method="post" action="/account/privacy/revoke-health" data-confirm="Rút lại sự đồng ý xử lý dữ liệu sức khỏe của hồ sơ này?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="subjectPersonId" value="<%= x.person.id %>"><button class="btn btn-danger btn-sm">Rút lại</button></form></div><% }) %></section><% } %>
<% if(dependentConsentCandidates?.length){ %><section class="card card-pad" style="margin-top:18px"><h2>Kích hoạt lại dữ liệu người phụ thuộc</h2><p class="friendly-copy">Các hồ sơ dưới đây đang tạm ngừng chức năng sức khỏe vì chưa có sự đồng ý đang hoạt động.</p><% dependentConsentCandidates.forEach(p=>{ %><div class="list-row"><div><p class="l-title"><%= p.full_name %></p><p class="l-sub">Bạn đang là Chủ nhà hoặc người quản lý hồ sơ này.</p></div><form method="post" action="/account/privacy/grant-dependent-health"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="subjectPersonId" value="<%= p.id %>"><button class="btn btn-primary btn-sm">Kích hoạt lại</button></form></div><% }) %></section><% } %>
<%- include('../partials/app-end') %>
