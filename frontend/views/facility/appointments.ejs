<%- include('../partials/app-start', { title }) %>
<div class="page-head"><div><h1>Xử lý yêu cầu đặt lịch</h1><p class="sub">Xem từng yêu cầu và xử lý đúng theo trạng thái. Quyền hồ sơ chỉ hoạt động sau khi lịch được xác nhận.</p></div></div>
<nav class="ui-core-tabs" aria-label="Lọc trạng thái lịch hẹn"><% [['all','Tất cả'],['pending','Chờ xử lý'],['proposed_time','Chờ phản hồi'],['confirmed','Đã xác nhận'],['completed','Hoàn thành'],['cancelled','Đã hủy'],['rejected','Từ chối']].forEach(([key,label])=>{ %><a href="/facility/appointments?status=<%= key %>" class="ui-core-tab <%= status===key?'is-active':'' %>"><%= label %> <span><%= key==='all'?Object.values(counts).reduce((a,b)=>a+b,0):(counts[key]||0) %></span></a><% }) %></nav>
<% if(!appointments.length){ %><div class="empty-state">Không có lịch hẹn phù hợp với bộ lọc.</div><% } %><div class="appointment-stack"><% appointments.forEach(a=>{ %><section class="appt-card facility-appt-card"><div class="appt-top"><div><h3><%= a.profile?.person?.full_name || 'Hồ sơ' %></h3><p><%= a.reason || 'Không ghi lý do khám' %></p></div><span class="pill <%= a.status==='confirmed'?'tone-mint':a.status==='pending'?'tone-peach':a.status==='proposed_time'?'tone-blue':a.status==='completed'?'tone-mint':'tone-red' %>"><%= ui.appointmentStatus(a.status) %></span></div><div class="appointment-meta-grid"><div><small><%= ['confirmed','completed'].includes(a.status) && a.confirmed_for ? 'Thời gian đã xác nhận' : 'Thời gian mong muốn' %></small><b><%= new Intl.DateTimeFormat('vi-VN',{timeZone:'Asia/Ho_Chi_Minh',dateStyle:'medium',timeStyle:'short'}).format(new Date(['confirmed','completed'].includes(a.status) && a.confirmed_for ? a.confirmed_for : a.requested_for)) %></b><% if (['confirmed','completed'].includes(a.status) && a.confirmed_for && new Date(a.confirmed_for).getTime() !== new Date(a.requested_for).getTime()) { %><small class="ui-appointments-original-time">Yêu cầu ban đầu: <%= new Intl.DateTimeFormat('vi-VN',{timeZone:'Asia/Ho_Chi_Minh',dateStyle:'medium',timeStyle:'short'}).format(new Date(a.requested_for)) %></small><% } %></div><div><small>Quyền hồ sơ</small><b><%= a.status==='confirmed'&&!a.access_revoked_at?'Đang hoạt động':'Chưa kích hoạt / đã kết thúc' %></b></div></div>
<% if(a.status==='pending'){ %><div class="appointment-actions"><form method="post" action="/facility/appointments/<%= a.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="action" value="confirm"><button class="btn btn-success btn-sm">Xác nhận</button></form><button class="btn btn-warning btn-sm" type="button" data-toggle-target="propose-<%= a.id %>">Đề xuất giờ khác</button><form method="post" action="/facility/appointments/<%= a.id %>" data-confirm="Từ chối yêu cầu đặt lịch này?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="action" value="reject"><button class="btn btn-danger btn-sm">Từ chối</button></form></div><form id="propose-<%= a.id %>" hidden class="proposal-form" method="post" action="/facility/appointments/<%= a.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="action" value="propose"><label class="field"><span>Thời gian đề xuất</span><input type="datetime-local" name="proposedFor" required></label><label class="field"><span>Lời nhắn (tùy chọn)</span><input name="note" maxlength="500"></label><button class="btn btn-primary btn-sm">Gửi đề xuất</button></form><% } %>
<% if(a.status==='proposed_time'){ %><div class="proposal-box"><b>Đang chờ Thành viên phản hồi.</b><br>Thời gian đã đề xuất: <%= new Intl.DateTimeFormat('vi-VN',{timeZone:'Asia/Ho_Chi_Minh',dateStyle:'medium',timeStyle:'short'}).format(new Date(a.proposed_for)) %></div><div class="appointment-actions"><form method="post" action="/facility/appointments/<%= a.id %>" data-confirm="Kết thúc yêu cầu này?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="action" value="reject"><button class="btn btn-danger-ghost btn-sm">Từ chối yêu cầu</button></form></div><% } %>
<% if(a.status==='confirmed'&&!a.access_revoked_at){ %><div class="appointment-actions"><% if (ui.localDay(a.confirmed_for) <= ui.localDay(new Date())) { %><a class="btn btn-primary btn-sm" href="/facility/appointments/<%= a.id %>/result">Nhập kết quả khám</a><% } else { %><span class="pill tone-blue">Chưa đến ngày khám</span><% } %><% if(new Date(a.confirmed_for)>new Date()){ %><button class="btn btn-danger-ghost btn-sm" type="button" data-toggle-target="cancel-confirmed-<%= a.id %>">Yêu cầu hủy lịch</button><form hidden id="cancel-confirmed-<%= a.id %>" class="proposal-form ui-care-cancel-form" method="post" action="/facility/appointments/<%= a.id %>" data-confirm="Xác nhận hủy lịch đã được thống nhất với người bệnh?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="action" value="cancel"><label class="field"><span>Lý do hủy lịch (bắt buộc)</span><input name="note" minlength="10" maxlength="500" required placeholder="Vui lòng nhập lý do cụ thể"></label><button class="btn btn-danger btn-sm">Xác nhận hủy lịch</button></form><% } %></div><% } %>
<% if(a.status==='confirmed'&&a.access_revoked_at){ %><div class="permission-lock">Thành viên đã thu hồi quyền truy cập hồ sơ của lịch hẹn này.</div><% } %>
<% if (a.facility_response_note && ['proposed_time','confirmed','cancelled','rejected'].includes(a.status)) { %><div class="ui-appointments-facility-feedback" role="note"><strong>Phản hồi đã lưu:</strong> <%= a.facility_response_note %></div><% } %>
</section><% }) %></div>
<% if(totalPages > 1){ %><nav class="ui-core-pagination" aria-label="Phân trang lịch hẹn"><% if(page>1){ %><a class="btn btn-secondary btn-sm" href="/facility/appointments?status=<%= status %>&page=<%= page-1 %>">← Trước</a><% } %><span>Trang <strong><%= page %></strong> / <%= totalPages %> · <%= total %> lịch</span><% if(page<totalPages){ %><a class="btn btn-secondary btn-sm" href="/facility/appointments?status=<%= status %>&page=<%= page+1 %>">Tiếp →</a><% } %></nav><% } %>
<%- include('../partials/app-end') %>
