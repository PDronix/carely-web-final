<%- include('../partials/app-start', { title }) %>
<div class="page-head"><div><h1>Thuốc và lịch dùng thuốc</h1><p class="sub">Theo dõi thuốc đang dùng và thiết lập lịch nhắc theo từng hồ sơ bạn có quyền quản lý.</p></div><a class="btn btn-secondary" href="/care<%= profileId?'?profileId='+profileId:'' %>">Lịch chăm sóc</a></div>
<% if(!profiles.length){ %><div class="empty-state">Chưa có hồ sơ sức khỏe đang hoạt động.</div><% } else { %>
<div class="tabstrip"><% profiles.forEach(x=>{ %><a class="tabchip <%= Number(profileId)===Number(x.profile.id)?'is-active':'' %>" href="/medications?profileId=<%= x.profile.id %>"><%= x.person.full_name %><span class="mini-badge"><%= ui.access(x.accessLevel) %></span></a><% }) %></div>
<% if(selected && !selected.capabilities.canManageMedication){ %><div class="role-banner">👁️ <div><b>Hồ sơ này đang ở chế độ chỉ xem.</b><br>Bạn có thể xem thuốc và lịch dùng, nhưng không thể thêm, dừng thuốc hoặc thay đổi lịch nhắc.</div></div><% } %>
<div class="grid-2b"><section class="card card-pad"><div class="card-head" style="padding:0 0 14px;border:none"><h2>Thuốc đang quản lý</h2></div><% if(!medications.length){ %><div class="empty-state">Chưa có thuốc.</div><% } %><% medications.forEach(m=>{ %><div class="list-row"><div><p class="l-title"><%= m.name %> <% if(m.source_type==='facility_prescribed'){ %><span class="mini-badge expired">Đơn từ cơ sở y tế</span><% } %></p><p class="l-sub"><%= m.dosage || 'Chưa ghi liều dùng' %> · <%= m.schedules.filter(s=>s.is_active!==false).map(s=>String(s.time_of_day).slice(0,5)).join(', ') || 'Chưa đặt giờ dùng' %></p><div class="med-status-line"><span class="mini-badge <%= m.status==='active'?'access':'expired' %>"><%= m.status==='active'?'Đang dùng':'Đã ngừng' %></span><span class="mini-badge <%= m.reminder_state==='active'?'access':m.reminder_state==='draft'?'pending':'expired' %>"><%= m.reminder_state==='active'?'Nhắc đang bật':m.reminder_state==='draft'?'Chờ xác nhận nhắc':'Nhắc đang tắt' %></span></div></div><div><% if(selected?.capabilities.canManageMedication && m.source_type==='facility_prescribed' && m.reminder_state==='draft'){ %><form method="post" action="/medications/<%= m.id %>/confirm-reminder" style="margin-top:6px"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-secondary btn-sm">Xác nhận lịch nhắc</button></form><% } %><% if(selected?.capabilities.canManageMedication && m.status==='active' && m.reminder_state==='active'){ %><form method="post" action="/medications/<%= m.id %>/reminder" style="margin-top:6px"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="action" value="disable"><button class="btn btn-ghost btn-sm">Tắt nhắc</button></form><% } %><% if(selected?.capabilities.canManageMedication && m.status==='active' && m.reminder_state==='none' && m.schedules.some(s=>s.is_active!==false)){ %><form method="post" action="/medications/<%= m.id %>/reminder" style="margin-top:6px"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="action" value="enable"><button class="btn btn-secondary btn-sm">Bật nhắc</button></form><% } %><% if(selected?.capabilities.canManageMedication && m.source_type==='self_recorded' && m.status==='active'){ %><button type="button" class="btn btn-secondary btn-sm" style="margin-top:6px" data-toggle-target="med-edit-<%= m.id %>">Sửa thuốc</button><form method="post" action="/medications/<%= m.id %>/stop" style="margin-top:6px" data-confirm="Ngừng thuốc này và dừng lịch nhắc liên quan?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-danger-ghost btn-sm">Ngừng thuốc</button></form><% } %></div></div><% if(selected?.capabilities.canManageMedication && m.source_type==='self_recorded' && m.status==='active'){ const activeSchedules=m.schedules.filter(s=>s.is_active!==false); %><div id="med-edit-<%= m.id %>" class="inline-edit-panel medication-edit-panel" hidden><form class="form-stack" method="post" action="/medications/<%= m.id %>/update"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="field"><span>Tên thuốc</span><input name="name" value="<%= m.name %>" required maxlength="180"></label><label class="field"><span>Liều dùng</span><input name="dosage" value="<%= m.dosage || '' %>" maxlength="120"></label><div class="time-list" data-time-list><div class="time-list-head"><span>Giờ uống thuốc</span><button class="btn btn-secondary btn-sm" type="button" data-add-time>+ Thêm giờ uống</button></div><div data-time-rows><% if(activeSchedules.length){ activeSchedules.forEach(sc=>{ %><div class="time-row"><input type="time" name="times" value="<%= String(sc.time_of_day).slice(0,5) %>"><button type="button" class="icon-btn time-remove" data-remove-time aria-label="Xóa giờ">×</button></div><% }) } else { %><div class="time-row"><input type="time" name="times"><button type="button" class="icon-btn time-remove" data-remove-time aria-label="Xóa giờ">×</button></div><% } %></div></div><div class="field-row"><label class="field"><span>Ngày bắt đầu</span><input type="date" name="startDate" value="<%= m.start_date || '' %>" required></label><label class="field"><span>Ngày kết thúc</span><input type="date" name="endDate" value="<%= m.end_date || '' %>"></label></div><label class="field"><span>Hướng dẫn</span><textarea name="instructions" maxlength="1000"><%= m.instructions || '' %></textarea></label><label class="check-row"><input type="checkbox" name="enableReminder" <%= m.reminder_state==='active'?'checked':'' %>><span>Bật lịch nhắc theo các giờ đã thêm</span></label><div class="form-actions"><button class="btn btn-primary">Lưu thay đổi</button><button type="button" class="btn btn-ghost" data-toggle-target="med-edit-<%= m.id %>">Đóng</button></div></form></div><% } %><% }) %></section>
<% if(selected?.capabilities.canManageMedication){ %><section class="card card-pad"><div class="card-head" style="padding:0 0 14px;border:none"><div><h2>Thêm thuốc</h2><p>Thêm từng giờ uống để tránh nhập sai định dạng.</p></div></div><form class="form-stack" method="post" action="/medications"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="profileId" value="<%= profileId %>"><label class="field"><span>Tên thuốc</span><input name="name" required maxlength="180"></label><label class="field"><span>Liều dùng</span><input name="dosage" maxlength="120" placeholder="VD: 1 viên/lần"></label><div class="time-list" data-time-list><div class="time-list-head"><span>Giờ uống thuốc</span><button class="btn btn-secondary btn-sm" type="button" data-add-time>+ Thêm giờ uống</button></div><div data-time-rows><div class="time-row"><input type="time" name="times"><button type="button" class="icon-btn time-remove" data-remove-time aria-label="Xóa giờ">×</button></div></div></div><div class="field-row"><label class="field"><span>Ngày bắt đầu</span><input type="date" name="startDate" required></label><label class="field"><span>Ngày kết thúc</span><input type="date" name="endDate"></label></div><label class="field"><span>Hướng dẫn</span><textarea name="instructions" maxlength="1000" placeholder="VD: Uống sau ăn"></textarea></label><label class="check-row"><input type="checkbox" name="enableReminder"><span>Bật lịch nhắc theo các giờ đã thêm</span></label><button class="btn btn-primary">Thêm thuốc</button></form></section><% } %></div>
<% } %>
<%- include('../partials/app-end') %>
