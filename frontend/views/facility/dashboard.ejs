<%- include('../partials/app-start', { title }) %>
<div class="page-head"><div><p class="eyebrow">CỔNG CƠ SỞ Y TẾ</p><h1><%= facility.facility_name %></h1><p class="sub">Theo dõi lịch khám và xử lý những việc đang chờ trong ngày.</p></div><span class="pill tone-mint">Tài khoản đang hoạt động</span></div>
<div class="stat-grid"><div class="stat-card accent"><div class="k">Chờ xử lý</div><div class="v"><%= counts.pending || 0 %></div><div class="s">yêu cầu mới</div></div><div class="stat-card"><div class="k">Hôm nay</div><div class="v"><%= todayAppointments.length %></div><div class="s">lịch khám</div></div><div class="stat-card"><div class="k">Chờ kết quả</div><div class="v"><%= visitQueue.today.length+visitQueue.overdue.length %></div><div class="s">cần cập nhật hôm nay / quá hạn</div></div><div class="stat-card"><div class="k">Hoàn thành</div><div class="v"><%= counts.completed || 0 %></div><div class="s">lịch đã kết thúc</div></div></div>
<div class="facility-dashboard-grid"><section class="card card-pad"><div class="card-head" style="padding:0 0 16px;border:none"><div><h2>Lịch khám hôm nay</h2><p>Sắp xếp theo thời gian</p></div><a class="btn btn-ghost" href="/facility/appointments">Xem tất cả</a></div><% if(!todayAppointments.length){ %><div class="empty-state">Hôm nay chưa có lịch khám đã xác nhận.</div><% } %><div class="timeline-list"><% todayAppointments.forEach(a=>{ const time=a.confirmed_for||a.requested_for; %><div class="timeline-row"><time><%= new Intl.DateTimeFormat('vi-VN',{timeZone:'Asia/Ho_Chi_Minh',hour:'2-digit',minute:'2-digit'}).format(new Date(time)) %></time><span class="timeline-dot"></span><div><b><%= a.profile?.person?.full_name || 'Hồ sơ' %></b><small><%= a.reason || 'Không ghi lý do khám' %></small></div><span class="pill <%= a.status==='completed'?'tone-mint':'tone-blue' %>"><%= ui.appointmentStatus(a.status) %></span></div><% }) %></div></section>
<aside class="card card-pad"><div class="card-head" style="padding:0 0 16px;border:none"><div><h2>Việc cần xử lý</h2><p>Yêu cầu mới và kết quả khám đến hạn</p></div></div><div class="attention-list"><a href="/facility/appointments"><span class="attention-icon tone-peach">◷</span><div><b><%= counts.pending || 0 %> yêu cầu đặt lịch</b><small>Xác nhận, từ chối hoặc đề xuất thời gian</small></div><span>→</span></a><a href="/facility/results"><span class="attention-icon tone-mint">✚</span><div><b><%= visitQueue.today.length+visitQueue.overdue.length %> kết quả chờ nhập</b><small><%= visitQueue.today.length %> hôm nay · <%= visitQueue.overdue.length %> quá hạn</small></div><span>→</span></a></div></aside></div>
<section class="card card-pad" style="margin-top:20px"><div class="card-head" style="padding:0 0 16px;border:none"><div><h2>Lịch sắp tới</h2><p>Các lịch đã xác nhận gần nhất</p></div></div><div class="responsive-list"><% if(!upcoming.length){ %><div class="empty-state">Chưa có lịch sắp tới.</div><% } %><% upcoming.forEach(a=>{ %><div class="responsive-list-row"><div><b><%= a.profile?.person?.full_name || 'Hồ sơ' %></b><small><%= a.reason || 'Khám theo lịch hẹn' %></small></div><time><%= new Intl.DateTimeFormat('vi-VN',{timeZone:'Asia/Ho_Chi_Minh',dateStyle:'medium',timeStyle:'short'}).format(new Date(a.confirmed_for)) %></time><span class="pill tone-mint">Đã xác nhận</span></div><% }) %></div></section>
<%- include('../partials/app-end') %>
