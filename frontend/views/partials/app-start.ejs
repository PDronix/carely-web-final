<%- include('head', { title }) %>
<body>
<div class="mobile-topbar"><button class="icon-btn" id="openNav" type="button" aria-label="Mở menu" aria-controls="sidebar" aria-expanded="false">☰</button><a href="/" class="mobile-brand">Carely</a><span style="width:38px"></span></div>
<div class="nav-scrim" id="navScrim"></div>
<div class="layout"><aside class="sidebar" id="sidebar">
<a class="brand app-brand" href="<%= currentUser.account_type === 'member' ? '/app' : currentUser.account_type === 'facility' ? '/facility/status' : '/admin' %>"><span class="brand-mark">♥</span><span class="brand-name">Carely</span></a>
<div class="sidebar-links" aria-label="Điều hướng chức năng">
<% if (currentUser.account_type === 'member') { %>
  <p class="nav-label">TỔNG QUAN</p><nav class="nav"><a class="nav-item <%= path === '/app' ? 'is-active' : '' %>" href="/app"><svg class="nav-icon" aria-hidden="true"><use href="/icons.svg#home"></use></svg>Tổng quan</a></nav>
  <p class="nav-label nav-section-gap">SỨC KHỎE</p><nav class="nav"><a class="nav-item <%= path.startsWith('/profiles') ? 'is-active' : '' %>" href="/profiles"><svg class="nav-icon" aria-hidden="true"><use href="/icons.svg#file-heart"></use></svg>Hồ sơ sức khỏe</a><a class="nav-item <%= path.startsWith('/medications') ? 'is-active' : '' %>" href="/medications"><svg class="nav-icon" aria-hidden="true"><use href="/icons.svg#pill"></use></svg>Thuốc</a><a class="nav-item <%= path.startsWith('/care') ? 'is-active' : '' %>" href="/care"><svg class="nav-icon" aria-hidden="true"><use href="/icons.svg#calendar"></use></svg>Lịch chăm sóc</a><a class="nav-item <%= path.startsWith('/metrics') ? 'is-active' : '' %>" href="/metrics"><svg class="nav-icon" aria-hidden="true"><use href="/icons.svg#activity"></use></svg>Chỉ số sức khỏe</a><a class="nav-item <%= path.startsWith('/notes') ? 'is-active' : '' %>" href="/notes"><svg class="nav-icon" aria-hidden="true"><use href="/icons.svg#journal"></use></svg>Nhật ký chăm sóc</a></nav>
  <p class="nav-label nav-section-gap">Y TẾ</p><nav class="nav"><a class="nav-item <%= path.startsWith('/facilities') ? 'is-active' : '' %>" href="/facilities"><svg class="nav-icon" aria-hidden="true"><use href="/icons.svg#hospital"></use></svg>Cơ sở y tế</a><a class="nav-item <%= path.startsWith('/appointments') ? 'is-active' : '' %>" href="/appointments"><svg class="nav-icon" aria-hidden="true"><use href="/icons.svg#calendar"></use></svg>Lịch hẹn khám</a></nav>
  <p class="nav-label nav-section-gap">GIA ĐÌNH</p><nav class="nav"><a class="nav-item <%= path.startsWith('/family') ? 'is-active' : '' %>" href="/family"><svg class="nav-icon" aria-hidden="true"><use href="/icons.svg#users"></use></svg>Gia đình</a></nav>
<% } else if (currentUser.account_type === 'facility') { %>
  <p class="nav-label">CỔNG CƠ SỞ Y TẾ</p><nav class="nav"><a class="nav-item <%= path === '/facility' ? 'is-active' : '' %>" href="/facility"><svg class="nav-icon" aria-hidden="true"><use href="/icons.svg#home"></use></svg>Tổng quan cơ sở</a><a class="nav-item <%= path.startsWith('/facility/appointments') ? 'is-active' : '' %>" href="/facility/appointments"><svg class="nav-icon" aria-hidden="true"><use href="/icons.svg#calendar"></use></svg>Yêu cầu lịch hẹn</a><a class="nav-item <%= path.startsWith('/facility/results') ? 'is-active' : '' %>" href="/facility/results"><svg class="nav-icon" aria-hidden="true"><use href="/icons.svg#clipboard"></use></svg>Kết quả khám</a></nav>
<% } else { %>
  <p class="nav-label">QUẢN TRỊ HỆ THỐNG</p><nav class="nav"><a class="nav-item <%= path === '/admin' ? 'is-active' : '' %>" href="/admin"><svg class="nav-icon" aria-hidden="true"><use href="/icons.svg#home"></use></svg>Tổng quan quản trị</a><a class="nav-item <%= path.startsWith('/admin/facilities') ? 'is-active' : '' %>" href="/admin/facilities"><svg class="nav-icon" aria-hidden="true"><use href="/icons.svg#shield"></use></svg>Cơ sở y tế</a></nav>
<% } %>
</div>
<div class="sidebar-foot"><details class="account-menu"><summary class="user-card"><span class="avatar sz-md"><%= (currentUser.display_name || 'C').slice(0,1).toUpperCase() %></span><span><span class="name"><%= currentUser.display_name %></span><span class="role"><%= currentUser.account_type === 'member' ? (isOwner ? 'Chủ nhà' : 'Thành viên') : currentUser.account_type === 'facility' ? 'Cơ sở y tế' : 'Quản trị viên' %></span></span><span class="gear" aria-hidden="true">⋮</span></summary><div class="account-popover"><a href="/account">Thông tin tài khoản</a><% if(currentUser.account_type === 'member'){ %><a href="/account/privacy">Quyền riêng tư & dữ liệu</a><% } %><div class="account-divider"></div><form method="post" action="/auth/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit">Đăng xuất</button></form></div></details></div>
</aside><main class="main page-enter"><header class="ui-core-topbar"><div><span class="ui-core-breadcrumb">CARELY <span aria-hidden="true">/</span> <%= currentUser.account_type === 'member' ? 'KHÔNG GIAN SỨC KHỎE' : currentUser.account_type === 'facility' ? 'CƠ SỞ Y TẾ' : 'QUẢN TRỊ' %></span></div><span class="ui-core-top-user"><span class="ui-core-online-dot" aria-hidden="true"></span><%= currentUser.display_name %></span></header><%- include('flash') %>
