# Ban mau: sao chep thanh .env va thay gia tri bang cau hinh MySQL cua ban
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=carely
DB_USER=root
DB_PASS=
SESSION_SECRET=change-this-to-a-random-long-secret-at-least-32-characters
SESSION_COOKIE_NAME=carely.sid
REMEMBER_ME_DAYS=7
PASSWORD_RESET_MINUTES=30
MAIL_MODE=console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Carely <no-reply@carely.local>
TERMS_VERSION=1.0
PRIVACY_VERSION=1.0
HEALTH_CONSENT_VERSION=1.0
UPLOAD_MAX_MB=10
