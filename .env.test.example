# Copy to .env.test. NEVER point tests at a production database.
NODE_ENV=test
CARELY_TEST_DB=1
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=carely_test
SESSION_SECRET=local-test-only-change-this-value-32chars
